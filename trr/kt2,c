#include <stdio.h>

int nextCombination(int n, int k, int a[]) {
    int i = k;

    while (i > 0 && a[i] == n -k + i) {
        i--;
    }
    if(i == 0) return 0;
    a[i]++;
    for(int j=i+1;j<=k;j++) {
        a[j] = a[j-1] +1;
    }
    return 1;
}

int prevCombination(int n, int k, int a[]) {
    int i= k;
    while(i>1 && a[i]==a[i-1] +1) {
        i--;
    }
    if(i==1 && a[1]== 1) return 0;
}